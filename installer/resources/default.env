# Atlas SEO - Default Configuration
# Rename this file to .env and place it next to docker-compose.yml

# ── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=atlas-change-this-in-production

# ── AI Engine (Ollama runs locally — no API key needed) ─────────────────────
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# ── Database (managed by Docker — no changes needed) ────────────────────────
DATABASE_URL=postgresql+asyncpg://atlas:atlas@db:5432/atlas
REDIS_URL=redis://redis:6379/0

# ── Optional: External APIs (leave blank if not using) ──────────────────────
# SERPAPI_KEY=
# SCRAPINGBEE_KEY=

# ── Optional: Google Search Console (for analytics) ─────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Optional: CMS Connections (configure in the Atlas dashboard) ─────────────
# WORDPRESS_URL=
# WORDPRESS_USER=
# WORDPRESS_APP_PASSWORD=
# SHOPIFY_STORE=
# SHOPIFY_ACCESS_TOKEN=
