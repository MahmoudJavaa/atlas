# ── Copy this to Railway as environment variables ─────────────────────────────

# Database (Railway provides this automatically when you add PostgreSQL plugin)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/railway

# Redis (Railway provides this automatically when you add Redis plugin)
REDIS_URL=redis://default:password@host:6379

# AI — Get a FREE key at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Security — generate a random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-very-long-random-secret-key-here

# CORS — your Vercel frontend URL (add your custom domain too after setup)
ALLOWED_ORIGINS=https://your-app.vercel.app,https://yourdomain.com

# Google Search Console (optional — leave blank to skip)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-backend.railway.app/api/analytics/oauth/callback

# Debug — set to false in production
DEBUG=false
